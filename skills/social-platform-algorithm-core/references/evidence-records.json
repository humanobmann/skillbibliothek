      "mechanism": "POLICY",
      "source_id": "META_EU_POLITICAL_ADS_2025",
      "surface": "paid_media",
      "observed_at": "2026-09-22",
      "limitation": "Applies to paid advertising in the EU only; organic reach and Recommendation Eligibility for political content follow separate, unrelated mechanisms.",
      "status": "active"
    },
    {
      "claim": "Instagram for Creators guidance emphasizes originality and documents that reposts or content with visible third-party watermarks have lower recommendation likelihood.",
