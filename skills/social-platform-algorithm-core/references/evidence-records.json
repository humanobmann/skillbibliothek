  "claims": [
    {
      "claim": "Facebook Feed Recommendations personalizes ranking using predicted viewing duration, share probability and like probability.",
      "evidence_level": "OFFICIAL",
      "mechanism": "RANKING",
      "source_id": "META_FB_FEED_RECS_2026",
      "surface": "feed_recommendations",
      "observed_at": "2026-09-22",
      "limitation": "Meta does not publish exact weights; signals are documented qualitatively, not as a fixed formula.",
      "status": "active"
    },
    {
      "claim": "Instagram Explore ranks candidates using like probability, save probability, viewing behavior and negative feedback signals.",
      "evidence_level": "OFFICIAL",
      "mechanism": "RANKING",
      "source_id": "META_IG_EXPLORE_2026",
      "surface": "explore",
      "observed_at": "2026-09-22",
      "limitation": "Signal list is not exhaustive and does not transfer automatically to Feed or Reels without separate evidence.",
      "status": "active"
    },
    {
      "claim": "Meta prioritizes original or substantially transformed content over duplicated or minimally edited content for Facebook Recommendation Eligibility.",
      "evidence_level": "OFFICIAL",
      "mechanism": "RECOMMENDATION_ELIGIBILITY",
      "source_id": "META_FB_ORIGINAL_2026",
      "surface": "feed_reels",
      "observed_at": "2026-09-22",
      "limitation": "Documented for Facebook; treating this as automatically identical on Instagram requires separate current evidence.",
      "status": "active"
    },
    {
      "claim": "Meta demotes and restricts engagement-bait tactics (vote baiting, tag baiting, share baiting, comment baiting) in Facebook Feed.",
      "evidence_level": "OFFICIAL",
      "mechanism": "POLICY",
      "source_id": "META_FB_ENGAGEMENT_BAIT_2017",
      "surface": "feed",
      "observed_at": "2026-09-22",
      "limitation": "Source dates from 2017; current enforcement mechanics may have changed, but the demotion principle is reaffirmed by later spam-crackdown guidance.",
      "status": "active"
    },
    {
      "claim": "Community Standards compliance and Recommendation Eligibility are separate states; a compliant post can still be excluded from non-follower recommendations or have distribution limited.",
      "evidence_level": "OFFICIAL",
      "mechanism": "RECOMMENDATION_ELIGIBILITY",
      "source_id": "META_RECOMMENDATION_GUIDELINES_2020",
      "surface": "feed_recommendations",
      "observed_at": "2026-09-22",
      "limitation": "Guidelines describe categories qualitatively; account-specific eligibility status is not independently verifiable without platform tools.",
      "status": "active"
    },
    {
      "claim": "Meta labels AI-generated and manipulated media on Facebook, Instagram and Threads as a policy/integrity function.",
      "evidence_level": "OFFICIAL",
      "mechanism": "POLICY",
      "source_id": "META_AI_LABELING_2024",
      "surface": "cross_platform",
      "observed_at": "2026-09-22",
      "limitation": "Labeling policy is documented; it is a separate mechanism from organic ranking and must not be conflated with a ranking claim.",
      "status": "active"
    },
    {
      "claim": "As of 6 October 2025, Meta ends political, electoral and social-issue advertising in the EU; this is a paid-media policy change and must not be equated with organic distribution.",
